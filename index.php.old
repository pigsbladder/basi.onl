        <div class="vu-label">VOICE SYNTHESIS &bull; AUDIO OUTPUT LEVEL</div>
        <div class="vu-rows" id="vuRows"></div>
      </div>

    </div><!-- /center -->

    <!-- RIGHT EAR -->
