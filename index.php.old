<script>
// ============================================================
//  WOPR ANIMATION ENGINE
// ============================================================

const VU_COLS = 28;
const VU_ROWS_COUNT = 4;
const EYE_COLS = 10;
const EYE_ROWS = 5;
const EAR_COUNT = 10;

let state = 'idle'; // idle | password | submitting | error | success
let animFrame;
let tick = 0;

// ---- BUILD DOM ----

function buildEar(id) {
  const el = document.getElementById(id);
  for (let i = 0; i < EAR_COUNT; i++) {
    const d = document.createElement('div');
    d.className = 'ear-led';
    d.id = id + '_' + i;
    el.appendChild(d);
  }
}

function buildEye(id) {
  const el = document.getElementById(id);
  for (let r = 0; r < EYE_ROWS; r++) {
    for (let c = 0; c < EYE_COLS; c++) {
      const d = document.createElement('div');
      d.className = 'eye-dot';
      d.id = id + '_' + r + '_' + c;
      el.appendChild(d);
    }
  }
}

function buildVU() {
  const container = document.getElementById('vuRows');
  for (let r = 0; r < VU_ROWS_COUNT; r++) {
    const row = document.createElement('div');
    row.className = 'vu-row';
    for (let c = 0; c < VU_COLS; c++) {
      const seg = document.createElement('div');
      seg.className = 'vu-seg';
      seg.id = 'vu_' + r + '_' + c;
      row.appendChild(seg);
    }
    container.appendChild(row);
  }
}

buildEar('earLeft');
buildEar('earRight');
buildEye('eyeLeft');
buildEye('eyeRight');
buildVU();

// ---- ANIMATION HELPERS ----

function setEarLed(id, index, color) {
  const el = document.getElementById(id + '_' + index);
  if (!el) return;
  el.className = 'ear-led' + (color ? ' lit-' + color : '');
}

function setEyeDot(id, row, col, cls) {
  const el = document.getElementById(id + '_' + row + '_' + col);
  if (!el) return;
  el.className = 'eye-dot' + (cls ? ' ' + cls : '');
}

function setVUSeg(row, col, cls) {
  const el = document.getElementById('vu_' + row + '_' + col);
  if (!el) return;
  el.className = 'vu-seg' + (cls ? ' ' + cls : '');
}

// ---- EAR ANIMATIONS ----

function animateEar(id, t, side) {
  const speed = 8;
  const offset = side === 'right' ? 3 : 0;
  for (let i = 0; i < EAR_COUNT; i++) {
    let color = null;
    const phase = (t / speed + i + offset) % EAR_COUNT;

    if (state === 'error') {
      color = (Math.floor(t / 4) % 2 === 0) ? 'red' : null;
    } else if (state === 'success') {
      color = 'green';
    } else if (state === 'submitting') {
      color = (Math.floor(t / 3 + i) % 3 === 0) ? 'amber' : null;
    } else {
      // Chase pattern
      const lit = Math.floor(phase) % EAR_COUNT;
      const lit2 = (Math.floor(phase) + 1) % EAR_COUNT;
      if (i === lit) color = 'amber';
      else if (i === lit2) color = 'green';
      else if (Math.random() < 0.003) color = 'red'; // rare flicker
    }
    setEarLed(id, i, color);
  }
}

// ---- EYE ANIMATIONS ----

// Returns a 2D array: 0=off, 1=pupil (full), 2=scan/ambient (50% opacity)
function getEyePattern(side, t) {
  const grid = [];
  for (let r = 0; r < EYE_ROWS; r++) {
    grid[r] = [];
    for (let c = 0; c < EYE_COLS; c++) {
      grid[r][c] = 0;
    }
  }

  if (state === 'error') {
    const on = Math.floor(t / 5) % 2 === 0;
    for (let r = 0; r < EYE_ROWS; r++)
      for (let c = 0; c < EYE_COLS; c++)
        grid[r][c] = on ? 1 : 0;
    return { grid, fullCls: 'lit-red', scanCls: 'lit-red' };
  }

  if (state === 'success') {
    for (let r = 0; r < 2; r++)
      for (let c = 0; c < EYE_COLS; c++)
        grid[r][c] = 1;
    return { grid, fullCls: 'lit-green', scanCls: 'lit-green' };
  }

  let gazeOffset = 0;
  if (state === 'password') gazeOffset = side === 'right' ? 2 : -1;
  if (state === 'submitting') gazeOffset = 0;

  for (let r = 0; r < EYE_ROWS; r++) {
    for (let c = 0; c < EYE_COLS; c++) {
      // Pupil: center cluster — full brightness
      const cx = 4 + gazeOffset;
      const cy = 2;
      const dist = Math.abs(c - cx) + Math.abs(r - cy) * 0.8;
      if (dist < 1.5) { grid[r][c] = 1; continue; }
    }
  }

  return { grid, fullCls: 'lit', scanCls: 'lit' };
}

function animateEye(id, side, t) {
  const { grid, fullCls, scanCls } = getEyePattern(side, t);
  for (let r = 0; r < EYE_ROWS; r++) {
    for (let c = 0; c < EYE_COLS; c++) {
      let dotCls = '';
      if      (grid[r][c] === 1) dotCls = fullCls;
      else if (grid[r][c] === 2) dotCls = scanCls;
      else if (Math.random() < 0.01) dotCls = 'lit-dim';
      setEyeDot(id, r, c, dotCls);
    }
  }
}

// ---- VU METER ANIMATION ----

// Organic "talking" level generator
let vuLevels = new Array(VU_COLS).fill(0);
let vuTargets = new Array(VU_COLS).fill(0);
let vuTimer = 0;

function updateVUTargets() {
  // Generate a speech-like envelope: center peaks, edges lower
  const center = VU_COLS / 2;
  const amplitude = state === 'submitting' ? 1.0
                  : state === 'error'      ? 0.9
                  : state === 'success'    ? 0.7
                  : state === 'password'   ? 0.55
                  : 0.35;

  for (let c = 0; c < VU_COLS; c++) {
    const distFromCenter = Math.abs(c - center) / center;
    const envelope = (1 - distFromCenter * 0.5);
    vuTargets[c] = (Math.random() * amplitude * envelope);
  }
}

function animateVU(t) {
  vuTimer++;
  if (vuTimer % 8 === 0) updateVUTargets();

  // Smooth toward targets
  for (let c = 0; c < VU_COLS; c++) {
    vuLevels[c] += (vuTargets[c] - vuLevels[c]) * 0.25;
  }

  for (let r = 0; r < VU_ROWS_COUNT; r++) {
    for (let c = 0; c < VU_COLS; c++) {
      const rowThreshold = (VU_ROWS_COUNT - 1 - r) / VU_ROWS_COUNT;
      const lit = vuLevels[c] > rowThreshold;
      let cls = '';
      if (lit) {
        const level = vuLevels[c];
        if (level > 0.75) cls = 'lit-r';
        else if (level > 0.45) cls = 'lit-y';
        else cls = 'lit-g';

        // Error state: all red
        if (state === 'error') cls = 'lit-r';
        if (state === 'success') cls = 'lit-g';
      }
      setVUSeg(r, c, cls);
    }
  }
}

// ---- CLOCK ----
function updateClock() {
  const now = new Date();
  const h = String(now.getHours()).padStart(2,'0');
  const m = String(now.getMinutes()).padStart(2,'0');
  const s = String(now.getSeconds()).padStart(2,'0');
  document.getElementById('clockText').textContent = h + ':' + m + ':' + s;
}
setInterval(updateClock, 1000);
updateClock();

// ---- MAIN LOOP ----
function loop() {
  tick++;
  animateEar('earLeft', tick, 'left');
  animateEar('earRight', tick, 'right');
  animateEye('eyeLeft', 'left', tick);
  animateEye('eyeRight', 'right', tick);
  animateVU(tick);
  animFrame = requestAnimationFrame(loop);
}
loop();

// ---- INPUT EVENTS ----
const panel = document.getElementById('woprPanel');
const statusText = document.getElementById('statusText');

document.getElementById('password').addEventListener('focus', () => {
  state = 'password';
  statusText.textContent = 'AWAITING ACCESS CODE...';
});
document.getElementById('password').addEventListener('blur', () => {
  if (state === 'password') { state = 'idle'; statusText.textContent = 'SYSTEM NOMINAL • AWAITING INPUT'; }
});

// ---- SUBMIT ----
document.getElementById('submitBtn').addEventListener('click', () => {
  state = 'submitting';
  statusText.textContent = 'PROCESSING REQUEST... STAND BY';
  setTimeout(() => document.getElementById('loginForm').submit(), 600);
});

// Also allow Enter key in the password field
document.getElementById('password').addEventListener('keydown', (e) => {
  if (e.key === 'Enter') document.getElementById('submitBtn').click();
});

<?php if ($error): ?>
// Error state on page load
state = 'error';
panel.classList.add('state-error', 'shake');
statusText.textContent = 'ACCESS DENIED • INVALID CREDENTIALS';
setTimeout(() => {
  panel.classList.remove('state-error', 'shake');
  state = 'idle';
  statusText.textContent = 'SYSTEM NOMINAL • AWAITING INPUT';
}, 2500);
<?php endif; ?>
</script>
</body>
</html>
<?php }

function render_admin_page(): void { ?>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>W.O.P.R. // SITE MANAGEMENT</title>
  <link href="https://fonts.googleapis.com/css2?family=VT323&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    [hidden] { display: none !important; }

    :root {
      --amber:        #FF6600;
      --amber-dim:    #cc5500;
      --amber-mid:    #ff8833;
      --amber-glow:   rgba(255,102,0,0.4);
      --amber-subtle: rgba(255,102,0,0.06);
      --green:        #00FF41;
      --red:          #FF2200;
      --yellow:       #FFD700;
      --bg:           #080808;
      --panel:        #111111;
      --muted:        #996633;
      --accent-dim:   #FF6600;
    }

    html, body {
      height: 100%;
      background: var(--bg);
      color: var(--amber);
      font-family: 'Share Tech Mono', monospace;
      font-size: 13px;
    }
    body {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-height: 100vh;
      position: relative;
    }

    /* CRT scanlines */
    body::before {
      content: '';
      position: fixed; inset: 0;
      background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.12) 2px, rgba(0,0,0,0.12) 4px);
      pointer-events: none; z-index: 1000;
    }
    /* CRT vignette */
    body::after {
      content: '';
      position: fixed; inset: 0;
      background: radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,0.82) 100%);
      pointer-events: none; z-index: 999;
    }
    .bg-glow {
      position: fixed; inset: 0;
      background: radial-gradient(ellipse at center, rgba(255,102,0,0.03) 0%, transparent 65%);
      pointer-events: none; z-index: 0;
    }
    body > * { position: relative; z-index: 1; }

    a { color: inherit; text-decoration: none; }

    /* ── Top bar ── */
    .adm-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .55rem 1.4rem;
      border-bottom: 1px solid #2a2a2a;
      background: #0d0d0d;
      flex-wrap: wrap;
      gap: .5rem;
      flex-shrink: 0;
    }
    .adm-brand {
      font-family: 'VT323', monospace;
      font-size: 30px;
      letter-spacing: 5px;
      color: var(--amber);
      text-shadow: 0 0 10px var(--amber-glow);
      line-height: 1;
    }
    .adm-brand-sub {
      font-size: 11px;
      color: var(--amber-dim);
      letter-spacing: 2px;
      margin-top: .2rem;
    }
    .adm-topbar-right {
      display: flex;
      align-items: center;
      gap: 1.4rem;
    }
    .adm-nav { display: flex; gap: 1rem; }
    .adm-nav-link {
      font-size: 13px;
      letter-spacing: 2px;
      color: var(--amber-dim);
      transition: color .15s, text-shadow .15s;
    }
    .adm-nav-link:hover {
      color: var(--amber);
      text-shadow: 0 0 8px var(--amber-glow);
    }
    #admClock {
      font-size: 13px;
      letter-spacing: 2px;
      color: #888;
    }

    /* ── Content wrapper ── */
    .adm-content {
      flex: 1;
      display: flex;
      justify-content: center;
      padding: 1.4rem 1rem 2rem;
      min-height: 0;
    }

    /* ── Main panel ── */
    .adm-panel {
      position: relative;
      width: min(1160px, 100%);
      background: var(--panel);
      border: 2px solid #2a2a2a;
      border-top: 2px solid #3a3a3a;
      border-left: 2px solid #3a3a3a;
      box-shadow: 0 0 50px rgba(255,102,0,0.07), inset 0 0 40px rgba(0,0,0,0.7);
      border-radius: 4px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .adm-panel::before, .adm-panel::after {
      content: ''; position: absolute;
      width: 18px; height: 18px;
      border-color: var(--amber-dim); border-style: solid;
    }
    .adm-panel::before { top: 7px; left: 7px; border-width: 2px 0 0 2px; }
    .adm-panel::after  { bottom: 7px; right: 7px; border-width: 0 2px 2px 0; }
    .corner-tr, .corner-bl {
      position: absolute;
      width: 18px; height: 18px;
      border-color: var(--amber-dim); border-style: solid;
    }
    .corner-tr { top: 7px; right: 7px; border-width: 2px 2px 0 0; }
    .corner-bl { bottom: 7px; left: 7px; border-width: 0 0 2px 2px; }

    .adm-panel-hdr {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .5rem 1.2rem;
      border-bottom: 1px solid #222;
      background: rgba(0,0,0,0.35);
      flex-shrink: 0;
    }
    .adm-panel-label {
      font-family: 'VT323', monospace;
      font-size: 24px;
      letter-spacing: 4px;
      color: var(--amber);
      text-shadow: 0 0 8px var(--amber-glow);
    }
    #siteCount {
      font-size: 12px;
      color: var(--amber-dim);
      letter-spacing: 2px;
    }

    /* ── Table ── */
    .adm-table-wrap { overflow-x: auto; flex: 1; }

    .adm-table {
      width: 100%;
      border-collapse: collapse;
      font-family: 'Share Tech Mono', monospace;
    }
    .adm-table thead th {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--amber-dim);
      padding: .55rem .9rem;
      border-bottom: 1px solid #2a2a2a;
      text-align: left;
      font-weight: normal;
      white-space: nowrap;
    }
    .adm-table tbody td {
      padding: .6rem .9rem;
      border-bottom: 1px solid #1c1c1c;
      vertical-align: middle;
      color: var(--amber);
      font-size: 14px;
    }
    .adm-table tbody tr:last-child td { border-bottom: none; }
    .adm-table tbody tr:hover td { background: var(--amber-subtle); }

    .site-name-cell { max-width: 200px; }
    .site-name-text { cursor: pointer; transition: text-shadow .1s; }
    .site-name-text:hover { text-shadow: 0 0 8px var(--amber-glow); }
    .site-name-input {
      background: transparent; border: none;
      border-bottom: 1px solid var(--amber);
      color: var(--amber); font-family: 'Share Tech Mono', monospace;
      font-size: 13px; padding: .1rem .2rem;
      width: 100%; outline: none; caret-color: var(--amber);
    }
    .site-id { color: var(--amber-dim); letter-spacing: 1px; }

    /* Badges */
    .badge {
      font-size: 11px; letter-spacing: 1px;
      padding: .1rem .5rem; border: 1px solid;
      white-space: nowrap;
    }
    .badge-protected { color: var(--amber); border-color: var(--amber-dim); text-shadow: 0 0 6px var(--amber-glow); }
    .badge-public    { color: #666; border-color: #333; }

    /* Actions */
    .actions { display: flex; gap: .3rem; flex-wrap: wrap; align-items: center; }

    /* ── Buttons ── */
    .btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: 'Share Tech Mono', monospace;
      font-size: 12px; letter-spacing: 1px;
      padding: .25rem .65rem;
      background: transparent; cursor: pointer;
      border: 1px solid; transition: all .15s;
      white-space: nowrap;
    }
    .btn:disabled { opacity: .3; cursor: not-allowed; }

    .btn-secondary { border-color: #3a2810; color: var(--muted); }
    .btn-secondary:not(:disabled):hover {
      border-color: var(--amber-dim); color: var(--amber);
      box-shadow: 0 0 8px rgba(255,102,0,0.25);
    }
    .btn-primary {
      border-color: var(--amber); color: var(--amber);
      box-shadow: 0 0 6px rgba(255,102,0,0.2);
    }
    .btn-primary:not(:disabled):hover {
      background: rgba(255,102,0,0.08);
      box-shadow: 0 0 14px var(--amber-glow);
    }
    .btn-danger { border-color: #4a1000; color: #cc2200; }
    .btn-danger:not(:disabled):hover {
      border-color: var(--red); color: var(--red);
      box-shadow: 0 0 8px rgba(255,34,0,0.35);
    }
    .btn-ghost { border-color: transparent; color: #666; }
    .btn-ghost:not(:disabled):hover { color: var(--amber-dim); }
    .btn-sm { font-size: 11px; padding: .18rem .45rem; }

    /* Empty state */
    .empty-state {
      text-align: center; padding: 4rem 1rem;
      color: var(--amber-dim); letter-spacing: 2px;
      font-size: 11px; line-height: 2;
    }

    /* ── Modals ── */
    .modal-backdrop {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.9);
      display: flex; align-items: center; justify-content: center;
      z-index: 100; padding: 1rem; overflow-y: auto;
    }
    .modal {
      position: relative;
      background: var(--panel);
      border: 2px solid #2a2a2a;
      border-top: 2px solid #3a3a3a;
      border-left: 2px solid #3a3a3a;
      box-shadow: 0 0 50px rgba(255,102,0,0.15), inset 0 0 30px rgba(0,0,0,0.8);
      border-radius: 4px;
      padding: 1.6rem 1.8rem;
      width: 100%; max-width: 420px;
    }
    .modal::before, .modal::after {
      content: ''; position: absolute;
      width: 14px; height: 14px;
      border-color: var(--amber-dim); border-style: solid;
    }
    .modal::before { top: 6px; left: 6px; border-width: 1px 0 0 1px; }
    .modal::after  { bottom: 6px; right: 6px; border-width: 0 1px 1px 0; }

    .modal h2 {
      font-family: 'VT323', monospace;
      font-size: 20px; letter-spacing: 3px;
      color: var(--amber); margin-bottom: 1rem;
      text-shadow: 0 0 8px var(--amber-glow);
    }
    .modal strong { color: var(--amber); }
    .modal code { color: var(--amber); letter-spacing: 1px; }

    .modal input[type=password], .modal input[type=text] {
      width: 100%; background: #060606;
      border: 1px solid #2a2a2a;
      border-bottom: 1px solid var(--amber-dim);
      color: var(--amber); font-family: 'Share Tech Mono', monospace;
      font-size: 13px; padding: .5rem .6rem;
      outline: none; margin-bottom: .8rem;
      caret-color: var(--amber); letter-spacing: 1px;
      transition: border-color .2s, box-shadow .2s;
    }
    .modal input:focus {
      border-color: var(--amber);
      box-shadow: 0 0 0 1px var(--amber-dim), 0 0 10px rgba(255,102,0,0.2);
    }

    .modal-actions { display: flex; gap: .5rem; justify-content: flex-end; margin-top: .4rem; }
    .modal-error { color: var(--red); font-size: 11px; letter-spacing: 1px; margin-bottom: .6rem; }

    /* ── File manager modal ── */
    .modal-wide {
      max-width: 820px;
      height: 76vh; max-height: 76vh;
      padding: 0; display: flex; flex-direction: column; overflow: hidden;
    }
    .fm-header {
      display: flex; align-items: flex-start;
      justify-content: space-between; gap: 1rem;
      padding: 1rem 1.4rem .8rem;
      border-bottom: 1px solid #1e1e1e; flex-shrink: 0;
    }
    .fm-header h2 {
      font-family: 'VT323', monospace;
      font-size: 20px; letter-spacing: 3px;
      color: var(--amber); text-shadow: 0 0 8px var(--amber-glow);
      margin-bottom: 0;
    }
    .fm-meta { font-size: 10px; color: var(--amber-dim); letter-spacing: 1px; margin-top: .2rem; }

    .fm-dropzone {
      margin: .7rem 1.4rem;
      padding: .6rem 1rem;
      border: 1px dashed #3a2810;
      font-size: 13px; color: var(--muted);
      text-align: center; letter-spacing: 1px;
      transition: border-color .15s, box-shadow .15s;
      cursor: default; flex-shrink: 0;
    }
    .fm-dropzone.fm-drag {
      border-color: var(--amber); color: var(--amber);
      box-shadow: 0 0 10px rgba(255,102,0,0.2);
    }
    .fm-dropzone label { color: var(--amber-dim); cursor: pointer; }
    .fm-dropzone label:hover { color: var(--amber); }

    .fm-list-wrap { overflow-y: auto; flex: 1; min-height: 0; padding: 0 1.4rem 1.4rem; }
    .fm-list { display: flex; flex-direction: column; gap: 1px; margin-top: .4rem; }

    .fm-row {
      display: flex; align-items: center; gap: .6rem;
      padding: .3rem .4rem; transition: background .1s;
    }
    .fm-row:hover { background: var(--amber-subtle); }
    .fm-path {
      flex: 1; font-size: 13px; color: var(--amber);
      word-break: break-all; min-width: 0;
    }
    .fm-path::before { content: '> '; color: var(--amber-dim); }
    .fm-size { font-size: 12px; color: var(--muted); white-space: nowrap; flex-shrink: 0; }
    .fm-loading, .fm-empty {
      padding: 2rem; text-align: center;
      color: var(--amber-dim); font-size: 13px; letter-spacing: 2px;
    }

    /* ── Toast ── */
    .toast {
      position: fixed; bottom: 1.5rem; left: 50%;
      transform: translateX(-50%);
      background: var(--panel);
      border: 1px solid var(--amber-dim);
      color: var(--amber); font-family: 'Share Tech Mono', monospace;
      font-size: 11px; letter-spacing: 2px;
      padding: .35rem 1.2rem; white-space: nowrap;
      animation: toastIn .2s ease, toastOut .3s ease 1.7s forwards;
      pointer-events: none; z-index: 200;
      box-shadow: 0 0 12px var(--amber-glow);
    }
    @keyframes toastIn  { from { opacity:0; transform:translateX(-50%) translateY(8px); } }
    @keyframes toastOut { to   { opacity:0; transform:translateX(-50%) translateY(8px); } }

    /* ── Scrollbars ── */
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #2e1a08; }
    ::-webkit-scrollbar-thumb:hover { background: var(--amber-dim); }

    @media (max-width: 700px) {
      .adm-table thead th:nth-child(2),
      .adm-table tbody td:nth-child(2),
      .adm-table thead th:nth-child(4),
      .adm-table tbody td:nth-child(4) { display: none; }
    }
  </style>
</head>
<body>
<div class="bg-glow"></div>

<!-- Top bar -->
<div class="adm-topbar">
  <div>
    <div class="adm-brand">W.O.P.R.</div>
    <div class="adm-brand-sub">SITE MANAGEMENT CONSOLE // SECURE NODE 7</div>
  </div>
  <div class="adm-topbar-right">
    <nav class="adm-nav">
      <a href="/" class="adm-nav-link">UPLOAD</a>
      <a href="/admin/logout" class="adm-nav-link">SIGN OUT</a>
    </nav>
    <div id="admClock"></div>
  </div>
</div>

<!-- Main content -->
<div class="adm-content">
  <div class="adm-panel">
    <div class="corner-tr"></div>
    <div class="corner-bl"></div>

    <div class="adm-panel-hdr">
      <span class="adm-panel-label">DEPLOYED SITES</span>
      <span id="siteCount"></span>
    </div>

    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead>
          <tr>
            <th>NAME</th>
            <th>ID</th>
            <th>UPLOADED</th>
            <th>FILES</th>
            <th>SIZE</th>
            <th>STATUS</th>
            <th>ACTIONS</th>
          </tr>
        </thead>
        <tbody id="sitesTbody">
          <tr><td colspan="7" style="padding:1.5rem;color:#996633;letter-spacing:2px;">LOADING SITE REGISTRY...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Password modal -->
<div class="modal-backdrop" id="pwModal" hidden>
  <div class="modal">
    <h2 id="pwModalTitle">SET PASSWORD</h2>
    <p class="modal-error" id="pwModalError" hidden></p>
    <input type="password" id="pwInput" placeholder="new password" autocomplete="new-password">
    <div class="modal-actions">
      <button class="btn btn-ghost" id="pwCancel">Cancel</button>
      <button class="btn btn-primary" id="pwSave" style="width:auto;padding:.35rem 1rem;margin:0;">Save</button>
    </div>
  </div>
</div>

<!-- Confirm delete site modal -->
<div class="modal-backdrop" id="deleteModal" hidden>
  <div class="modal">
    <h2>DELETE SITE?</h2>
    <p style="color:var(--muted);font-size:.875rem;margin-bottom:1.2rem;">
      Permanently remove <strong id="deleteName"></strong> and all its files.
    </p>
    <div class="modal-actions">
      <button class="btn btn-ghost" id="deleteCancel">Cancel</button>
      <button class="btn btn-danger" id="deleteConfirm">Delete</button>
    </div>
  </div>
</div>

<!-- File manager modal -->
<div class="modal-backdrop" id="filesModal" hidden>
  <div class="modal modal-wide">
    <div class="fm-header">
      <div>
        <h2 id="fmTitle">FILES</h2>
        <p id="fmMeta" class="fm-meta"></p>
      </div>
      <button class="btn btn-ghost btn-sm" id="fmClose">&#10005;</button>
    </div>
    <div class="fm-dropzone" id="fmDropzone">
      <input type="file" id="fmFileInput" multiple hidden>
      <div id="fmDropLabel">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:middle;margin-right:.3rem"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        Drop files to add or replace &mdash; or <label for="fmFileInput">browse</label>
      </div>
      <div id="fmUploadProgress" hidden style="font-size:11px;color:var(--muted);letter-spacing:1px;">Uploading&hellip;</div>
    </div>
    <div class="fm-list-wrap">
      <div id="fmList" class="fm-list"><div class="fm-loading">LOADING&hellip;</div></div>
    </div>
  </div>
</div>

<!-- Confirm delete file modal -->
<div class="modal-backdrop" id="deleteFileModal" hidden>
  <div class="modal">
    <h2>DELETE FILE?</h2>
    <p style="color:var(--muted);font-size:.875rem;margin-bottom:1.2rem;">
      Remove <code id="deleteFileName"></code> from this site?
    </p>
    <div class="modal-actions">
      <button class="btn btn-ghost" id="deleteFileCancel">Cancel</button>
      <button class="btn btn-danger" id="deleteFileConfirm">Delete</button>
    </div>
  </div>
</div>

<script>
  // Clock
  (function tick() {
    const d = new Date();
    document.getElementById('admClock').textContent =
      [d.getHours(),d.getMinutes(),d.getSeconds()].map(n=>String(n).padStart(2,'0')).join(':');
    setTimeout(tick, 1000);
  })();

  let sites = [];

  // ── Utilities ───────────────────────────────────────────────────────────────
  function toast(msg) {
    const el = Object.assign(document.createElement('div'), { className: 'toast', textContent: msg });
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 2200);
  }

  function fmtDate(iso) {
    return new Date(iso).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  function fmtSize(bytes) {
    if (bytes === 0) return '0 B';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ── API helpers ─────────────────────────────────────────────────────────────
  async function api(method, path, body) {
    const isOverride = method === 'PATCH' || method === 'DELETE';
    const opts = {
      method: isOverride ? 'POST' : method,
      headers: isOverride ? { 'X-HTTP-Method-Override': method } : {},
    };
    if (body) { opts.body = JSON.stringify(body); opts.headers['Content-Type'] = 'application/json'; }
    const res = await fetch(path, opts);
    if (res.status === 401) { location.href = '/admin/login'; return null; }
    return res.json();
  }

  async function apiUpload(siteId, file, path) {
    const fd = new FormData();
    fd.append('file', file);
    fd.append('path', path);
    const res = await fetch(`/api/admin/sites/${siteId}/files`, { method: 'POST', body: fd });
    if (res.status === 401) { location.href = '/admin/login'; return null; }
    return res.json();
  }

  // ── Main table render ───────────────────────────────────────────────────────
  function render() {
    const tbody = document.getElementById('sitesTbody');
    document.getElementById('siteCount').textContent =
      sites.length ? `${sites.length} SITE${sites.length !== 1 ? 'S' : ''} ONLINE` : '';

    if (!sites.length) {
      tbody.innerHTML = `<tr><td colspan="7"><div class="empty-state">
        <div style="font-size:1.4rem;margin-bottom:.5rem">&#128194;</div>
        <div>NO SITES DEPLOYED</div>
        <div style="margin-top:.4rem;font-size:10px;"><a href="/" style="color:var(--accent-dim);letter-spacing:2px;">UPLOAD ONE &rsaquo;</a></div>
      </div></td></tr>`;
      return;
    }

    tbody.innerHTML = sites.map(s => {
      const url = window.location.origin + '/' + s.id;
      return `<tr data-id="${s.id}">
        <td class="site-name-cell">
          <span class="site-name-text" onclick="startRename('${s.id}')" title="Click to rename">${esc(s.name)}</span>
          <input class="site-name-input" style="display:none" value="${esc(s.name)}"
            onblur="commitRename('${s.id}',this)"
            onkeydown="if(event.key==='Enter')this.blur();if(event.key==='Escape')cancelRename('${s.id}',this)">
        </td>
        <td><span class="site-id">${s.id}</span></td>
        <td style="color:var(--muted);white-space:nowrap">${fmtDate(s.createdAt)}</td>
        <td style="color:var(--muted)">${s.fileCount ?? '—'}</td>
        <td style="color:var(--muted);white-space:nowrap">${s.sizeBytes != null ? fmtSize(s.sizeBytes) : '—'}</td>
        <td><span class="badge ${s.protected ? 'badge-protected' : 'badge-public'}">${s.protected ? 'LOCKED' : 'OPEN'}</span></td>
        <td class="actions">
          <button class="btn btn-secondary btn-sm" onclick="copyUrl('${url}')">Copy URL</button>
          <a class="btn btn-secondary btn-sm" href="${url}" target="_blank">Open</a>
          <button class="btn btn-secondary btn-sm" onclick="openFilesModal('${s.id}','${esc(s.name)}')">Files</button>
          ${s.protected
            ? `<button class="btn btn-secondary btn-sm" onclick="makePublic('${s.id}')">Make public</button>
               <button class="btn btn-secondary btn-sm" onclick="openPwModal('${s.id}','${esc(s.name)}')">Change pw</button>`
            : `<button class="btn btn-secondary btn-sm" onclick="openPwModal('${s.id}','${esc(s.name)}')">Set password</button>`}
          <button class="btn btn-danger btn-sm" onclick="openDeleteModal('${s.id}','${esc(s.name)}')">Delete</button>
        </td>
      </tr>`;
    }).join('');
  }

  async function load() {
    const data = await api('GET', '/api/admin/sites');
    if (data) { sites = data; render(); }
  }
  load();

  function copyUrl(url) { navigator.clipboard.writeText(url).then(() => toast('URL copied!')); }

  // ── Inline rename ──────────────────────────────────────────────────────────
  function startRename(id) {
    const row = document.querySelector(`tr[data-id="${id}"]`);
    row.querySelector('.site-name-text').style.display = 'none';
    const input = row.querySelector('.site-name-input');
    input.style.display = 'block';
    input.focus(); input.select();
  }
  function cancelRename(id, input) {
    const row = document.querySelector(`tr[data-id="${id}"]`);
    row.querySelector('.site-name-text').style.display = '';
    input.style.display = 'none';
    const s = sites.find(s => s.id === id);
    if (s) input.value = s.name;
  }
  async function commitRename(id, input) {
    const name = input.value.trim();
    const row  = document.querySelector(`tr[data-id="${id}"]`);
    const span = row.querySelector('.site-name-text');
    if (!name) { cancelRename(id, input); return; }
    const data = await api('PATCH', `/api/admin/sites/${id}`, { name });
    if (data?.ok) {
      const s = sites.find(s => s.id === id); if (s) s.name = name;
      span.textContent = name; toast('Renamed ✓');
    }
    input.style.display = 'none'; span.style.display = '';
  }

  // ── Protection ─────────────────────────────────────────────────────────────
  async function makePublic(id) {
    const data = await api('PATCH', `/api/admin/sites/${id}`, { protected: false, clearPassword: true });
    if (data?.ok) { const s = sites.find(s => s.id === id); if (s) s.protected = false; render(); toast('Made public ✓'); }
  }

  // ── Password modal ─────────────────────────────────────────────────────────
  let pwTargetId = null;
  function openPwModal(id, name) {
    pwTargetId = id;
    document.getElementById('pwModalTitle').textContent = `Set password for "${name}"`;
    document.getElementById('pwInput').value = '';
    document.getElementById('pwModalError').hidden = true;
    document.getElementById('pwModal').hidden = false;
    document.getElementById('pwInput').focus();
  }
  document.getElementById('pwCancel').onclick = () => document.getElementById('pwModal').hidden = true;
  document.getElementById('pwSave').onclick = async () => {
    const pw    = document.getElementById('pwInput').value;
    const errEl = document.getElementById('pwModalError');
    if (pw.length < 4) { errEl.textContent = 'Min 4 characters.'; errEl.hidden = false; return; }
    errEl.hidden = true;
    const data  = await api('PATCH', `/api/admin/sites/${pwTargetId}`, { password: pw });
    if (data?.ok) {
      const s = sites.find(s => s.id === pwTargetId); if (s) s.protected = true;
      render(); document.getElementById('pwModal').hidden = true; toast('Password set ✓');
    }
  };
  document.getElementById('pwInput').addEventListener('keydown', e => {
    if (e.key === 'Enter')  document.getElementById('pwSave').click();
    if (e.key === 'Escape') document.getElementById('pwModal').hidden = true;
  });
  document.getElementById('pwModal').parentElement.addEventListener('click', e => {
    if (e.target === document.getElementById('pwModal').parentElement)
      document.getElementById('pwModal').hidden = true;
  });

  // ── Delete site modal ──────────────────────────────────────────────────────
  let deleteTargetId = null;
  function openDeleteModal(id, name) {
    deleteTargetId = id;
    document.getElementById('deleteName').textContent = `"${name}"`;
    document.getElementById('deleteModal').hidden = false;
  }
  document.getElementById('deleteCancel').onclick = () => document.getElementById('deleteModal').hidden = true;
  document.getElementById('deleteConfirm').onclick = async () => {
    const data = await api('DELETE', `/api/admin/sites/${deleteTargetId}`);
    if (data?.ok) {
      sites = sites.filter(s => s.id !== deleteTargetId);
      render(); document.getElementById('deleteModal').hidden = true; toast('Deleted ✓');
    }
  };
  document.getElementById('deleteModal').parentElement.addEventListener('click', e => {
    if (e.target === document.getElementById('deleteModal').parentElement)
      document.getElementById('deleteModal').hidden = true;
  });

  // ── File manager ───────────────────────────────────────────────────────────
  let fmSiteId   = null;
  let fmFiles    = [];
  let fmDelPath  = null;

  async function openFilesModal(id, name) {
    fmSiteId = id;
    document.getElementById('fmTitle').textContent   = name;
    document.getElementById('fmMeta').textContent    = '';
    document.getElementById('fmList').innerHTML      = '<div class="fm-loading">Loading…</div>';
    document.getElementById('fmDropLabel').hidden    = false;
    document.getElementById('fmUploadProgress').hidden = true;
    document.getElementById('filesModal').hidden     = false;
    await fmLoad();
  }

  async function fmLoad() {
    const data = await api('GET', `/api/admin/sites/${fmSiteId}/files`);
    if (!data?.ok) return;
    fmFiles = data.files;
    fmRender();

    // Refresh the stats row in the main table too
    const s = sites.find(s => s.id === fmSiteId);
    if (s) {
      const totalBytes = fmFiles.reduce((sum, f) => sum + f.size, 0);
      s.fileCount = fmFiles.length;
      s.sizeBytes = totalBytes;
      render();
    }
  }

  function fmRender() {
    const list = document.getElementById('fmList');
    const totalBytes = fmFiles.reduce((sum, f) => sum + f.size, 0);
    document.getElementById('fmMeta').textContent =
      `${fmFiles.length} file${fmFiles.length !== 1 ? 's' : ''} · ${fmtSize(totalBytes)}`;

    if (!fmFiles.length) {
      list.innerHTML = '<div class="fm-empty">No files in this site yet.</div>';
      return;
    }

    list.innerHTML = fmFiles.map(f => `
      <div class="fm-row">
        <span class="fm-path">${esc(f.path)}</span>
        <span class="fm-size">${fmtSize(f.size)}</span>
        <button class="btn btn-danger btn-sm" onclick="openDeleteFileModal('${esc(f.path)}')">Delete</button>
      </div>`).join('');
  }

  // ── File upload in manager ────────────────────────────────────────────────
  const fmDropzone  = document.getElementById('fmDropzone');
  const fmFileInput = document.getElementById('fmFileInput');

  fmDropzone.addEventListener('dragover',  e => { e.preventDefault(); fmDropzone.classList.add('fm-drag'); });
  fmDropzone.addEventListener('dragleave', ()  => fmDropzone.classList.remove('fm-drag'));
  fmDropzone.addEventListener('drop', async e => {
    e.preventDefault();
    fmDropzone.classList.remove('fm-drag');
    await fmHandleFiles([...e.dataTransfer.files]);
  });
  fmFileInput.addEventListener('change', async e => {
    await fmHandleFiles([...e.target.files]);
    e.target.value = '';
  });

  async function fmHandleFiles(files) {
    if (!files.length) return;
    const progressEl = document.getElementById('fmUploadProgress');
    const labelEl    = document.getElementById('fmDropLabel');
    labelEl.hidden   = true;
    progressEl.hidden = false;

    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      progressEl.textContent = `Uploading ${i + 1}/${files.length}: ${file.name}…`;
      // Use webkitRelativePath if available (folder upload), otherwise just filename
      const path = file.webkitRelativePath || file.name;
      const data = await apiUpload(fmSiteId, file, path);
      if (!data?.ok) { toast(`Failed: ${file.name}`); }
    }

    labelEl.hidden    = false;
    progressEl.hidden = true;
    toast(`${files.length} file${files.length !== 1 ? 's' : ''} uploaded ✓`);
    await fmLoad();
  }

  // ── Delete file modal ─────────────────────────────────────────────────────
  function openDeleteFileModal(path) {
    fmDelPath = path;
    document.getElementById('deleteFileName').textContent = path;
    document.getElementById('deleteFileModal').hidden = false;
  }
  document.getElementById('deleteFileCancel').onclick  = () => document.getElementById('deleteFileModal').hidden = true;
  document.getElementById('deleteFileConfirm').onclick = async () => {
    const data = await api('DELETE', `/api/admin/sites/${fmSiteId}/files`, { path: fmDelPath });
    if (data?.ok) {
      document.getElementById('deleteFileModal').hidden = true;
      toast('File deleted ✓');
      await fmLoad();
    }
  };
  document.getElementById('deleteFileModal').parentElement.addEventListener('click', e => {
    if (e.target === document.getElementById('deleteFileModal').parentElement)
      document.getElementById('deleteFileModal').hidden = true;
  });

  // Close file manager
  document.getElementById('fmClose').onclick = () => document.getElementById('filesModal').hidden = true;
  document.getElementById('filesModal').parentElement.addEventListener('click', e => {
    if (e.target === document.getElementById('filesModal').parentElement)
      document.getElementById('filesModal').hidden = true;
  });
  </script>
</body>
</html>
<?php }

// ─────────────────────────────────────────────────────────────────────────────

function render_password_prompt(string $id, bool $error = false): void { ?>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Protected — basi.onl</title>
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <?php render_header(); ?>
  <main>
    <div class="login-card" style="text-align:center;">
      <div style="font-size:2rem;margin-bottom:.8rem;">🔒</div>
      <h1>Password protected</h1>
      <p style="color:var(--muted);font-size:.85rem;margin:.4rem 0 1.4rem;">Enter the password to view this site.</p>
      <form method="POST" action="/<?= htmlspecialchars($id) ?>/__auth">
        <input type="password" name="password" placeholder="Password" autofocus>
        <?php if ($error): ?>
          <p class="login-error">Incorrect password — try again.</p>
        <?php endif; ?>
        <button class="btn btn-primary" type="submit">Unlock</button>
      </form>
    </div>
  </main>
</body>
</html>
<?php }
