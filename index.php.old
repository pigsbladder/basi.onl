<?php
declare(strict_types=1);
ob_start(); // buffer output so headers can always be sent, even if a warning fires early

// Explicitly scope the session cookie to the whole domain path
session_set_cookie_params([
    'lifetime' => 0,
    'path'     => '/',
    'httponly' => true,
    'samesite' => 'Lax',
]);
session_start();

require_once __DIR__ . '/config.php';
require_once __DIR__ . '/inc/meta.php';
require_once __DIR__ . '/inc/auth.php';
require_once __DIR__ . '/inc/upload.php';
require_once __DIR__ . '/inc/serve.php';

// ─── Router ───────────────────────────────────────────────────────────────────
$method = $_SERVER['REQUEST_METHOD'];
$path   = '/' . trim(parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH), '/');

// Allow tunnelling PATCH/DELETE through POST via X-HTTP-Method-Override header.
// Some hosts (and older proxies) strip non-standard HTTP verbs; this ensures
// the admin API works everywhere.
if ($method === 'POST') {
    $override = $_SERVER['HTTP_X_HTTP_METHOD_OVERRIDE'] ?? '';
    if (in_array(strtoupper($override), ['PATCH', 'DELETE'], true)) {
        $method = strtoupper($override);
    }
}

if ($method === 'GET' && $path === '/') {
    require_admin();
    render_upload_page();

} elseif ($method === 'POST' && $path === '/upload') {
    require_admin();
    handle_upload();

} elseif ($method === 'GET' && $path === '/admin') {
    require_admin();
    render_admin_page();

} elseif ($method === 'GET' && $path === '/admin/login') {
    render_login_page(isset($_GET['error']));

} elseif ($method === 'POST' && $path === '/admin/login') {
    handle_admin_login();

} elseif ($method === 'GET' && $path === '/admin/logout') {
    handle_admin_logout();

} elseif ($method === 'GET' && $path === '/api/admin/sites') {
    require_admin(true);
    api_list_sites();

} elseif (preg_match('#^/api/admin/sites/([A-Za-z0-9_-]+)/files$#', $path, $m)) {
    require_admin(true);
    if ($method === 'GET')         api_list_site_files($m[1]);
    elseif ($method === 'POST')    api_upload_site_file($m[1]);
    elseif ($method === 'DELETE')  api_delete_site_file($m[1]);
    else json_out(['error' => 'Method not allowed'], 405);

} elseif (preg_match('#^/api/admin/sites/([A-Za-z0-9_-]+)$#', $path, $m)) {
    require_admin(true);
    if ($method === 'PATCH')       api_update_site($m[1]);
    elseif ($method === 'DELETE')  api_delete_site($m[1]);
    else json_out(['error' => 'Method not allowed'], 405);

} elseif ($method === 'POST' && preg_match('#^/([A-Za-z0-9_-]+)/__auth$#', $path, $m)) {
    handle_site_auth($m[1]);

} elseif (preg_match('#^/([A-Za-z0-9_-]+)(/.*)?$#', $path, $m)) {
    $siteId  = $m[1];
    $subpath = $m[2] ?? '';

    // ── Trailing-slash redirect ───────────────────────────────────────────────
    // When serving a site's root with no trailing slash (e.g. /abc12), relative
    // asset URLs inside the hosted HTML resolve against the wrong base directory.
    // Redirecting to /abc12/ makes the browser treat it as a directory, so
    // href="style.css" correctly resolves to /abc12/style.css on all browsers.
    if ($subpath === '') {
        $rawPath = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
        if (substr($rawPath, -1) !== '/') {
            header('Location: /' . $siteId . '/');
            exit;
        }
    }

    serve_site($siteId, $subpath ?: '/');

} else {
    http_response_code(404);
    echo '<h1>404 Not Found</h1>';
}

// ─── Helpers ──────────────────────────────────────────────────────────────────
function json_out(array $data, int $code = 200): void {
    http_response_code($code);
    header('Content-Type: application/json');
    echo json_encode($data);
    exit;
}

// ─── Upload handler ───────────────────────────────────────────────────────────
function handle_upload(): void {
    header('Content-Type: application/json');
    try {
        $id   = generate_id();
        $dest = SITES_DIR . '/' . $id;
        mkdir($dest, 0755, true);
        $name = $id;

        if (isset($_FILES['zip']) && $_FILES['zip']['error'] === UPLOAD_ERR_OK) {
            // ── ZIP upload
            $zip  = $_FILES['zip'];
            $name = $_POST['name'] ?? pathinfo($zip['name'], PATHINFO_FILENAME);
            extract_zip($zip['tmp_name'], $dest);

        } elseif (isset($_FILES['files'])) {
            // ── Directory upload
            $detected = extract_directory_files($dest);
            $name     = $_POST['name'] ?: $detected;

        } else {
            throw new RuntimeException('No files received.');
        }

        upsert_site([
            'id'           => $id,
            'name'         => $name,
            'createdAt'    => date('c'),
            'protected'    => false,
            'passwordHash' => null,
        ]);

        echo json_encode(['ok' => true, 'id' => $id, 'url' => "/{$id}"]);

    } catch (Throwable $e) {
        http_response_code(500);
        echo json_encode(['ok' => false, 'error' => $e->getMessage()]);
    }
    exit;
}

// ─── Admin session handlers ───────────────────────────────────────────────────
function handle_admin_login(): void {
    if (($_POST['password'] ?? '') === ADMIN_PASSWORD) {
        $_SESSION['admin']       = true;
        $_SESSION['admin_until'] = time() + (8 * 3600);
        header('Location: /admin');
    } else {
        header('Location: /admin/login?error=1');
    }
    exit;
}

function handle_admin_logout(): void {
    session_destroy();
    header('Location: /admin/login');
    exit;
}

// ─── Site password auth ───────────────────────────────────────────────────────
function handle_site_auth(string $id): void {
    $site = get_site($id);
    if (!$site || !$site['protected']) {
        header("Location: /{$id}");
        exit;
    }

    if (password_verify($_POST['password'] ?? '', $site['passwordHash'] ?? '')) {
        setcookie("site_{$id}", sign_value("site:{$id}"), [
            'expires'  => time() + 86400,
            'path'     => '/',
            'httponly' => true,
            'samesite' => 'Lax',
        ]);
        header("Location: /{$id}");
    } else {
        render_password_prompt($id, true);
    }
    exit;
}

// ─── Admin API ────────────────────────────────────────────────────────────────

// Recursively count files and sum their sizes for a site directory.
function site_disk_stats(string $id): array {
    $dir   = SITES_DIR . '/' . $id;
    $count = 0;
    $bytes = 0;
    if (is_dir($dir)) {
        $iter = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS)
        );
        foreach ($iter as $f) {
            if ($f->isFile()) { $count++; $bytes += $f->getSize(); }
        }
    }
    return ['fileCount' => $count, 'sizeBytes' => $bytes];
}

function api_list_sites(): void {
    json_out(array_map(function($s) {
        $stats = site_disk_stats($s['id']);
        return [
            'id'        => $s['id'],
            'name'      => $s['name'],
            'createdAt' => $s['createdAt'],
            'protected' => $s['protected'],
            'fileCount' => $stats['fileCount'],
            'sizeBytes' => $stats['sizeBytes'],
        ];
    }, read_meta()));
}

function api_update_site(string $id): void {
    $site = get_site($id);
    if (!$site) json_out(['error' => 'Not found'], 404);

    $body = json_decode(file_get_contents('php://input'), true) ?? [];

    if (array_key_exists('name', $body))      $site['name']      = trim((string)$body['name']);
    if (array_key_exists('protected', $body)) $site['protected'] = (bool)$body['protected'];

    if (!empty($body['password'])) {
        $site['passwordHash'] = password_hash($body['password'], PASSWORD_BCRYPT);
        $site['protected']    = true;
    }
    if (!empty($body['clearPassword'])) {
        $site['passwordHash'] = null;
        $site['protected']    = false;
    }

    upsert_site($site);
    json_out(['ok' => true, 'site' => [
        'id'        => $site['id'],
        'name'      => $site['name'],
        'protected' => $site['protected'],
    ]]);
}

function api_delete_site(string $id): void {
    $site = get_site($id);
    if (!$site) json_out(['error' => 'Not found'], 404);

    $dir = SITES_DIR . '/' . $id;
    if (is_dir($dir)) {
        $items = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS),
            RecursiveIteratorIterator::CHILD_FIRST
        );
        foreach ($items as $item) {
            $item->isDir() ? rmdir($item->getRealPath()) : unlink($item->getRealPath());
        }
        rmdir($dir);
    }

    delete_site_from_meta($id);
    json_out(['ok' => true]);
}

// ─── File manager API ─────────────────────────────────────────────────────────

// Return a flat sorted list of all files in the site with path + size.
function api_list_site_files(string $id): void {
    $site = get_site($id);
    if (!$site) json_out(['error' => 'Not found'], 404);

    $dir   = SITES_DIR . '/' . $id;
    $files = [];

    if (is_dir($dir)) {
        $iter = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS)
        );
        foreach ($iter as $f) {
            if ($f->isFile()) {
                $rel     = str_replace('\\', '/', substr($f->getPathname(), strlen($dir) + 1));
                $files[] = ['path' => $rel, 'size' => $f->getSize()];
            }
        }
    }

    usort($files, fn($a, $b) => strcmp($a['path'], $b['path']));
    json_out(['ok' => true, 'files' => $files]);
}

// Upload or replace a single file inside a site.
function api_upload_site_file(string $id): void {
    $site = get_site($id);
    if (!$site) json_out(['error' => 'Not found'], 404);

    if (!isset($_FILES['file']) || $_FILES['file']['error'] !== UPLOAD_ERR_OK) {
        json_out(['error' => 'No file received'], 400);
    }

    $dest       = SITES_DIR . '/' . $id;
    $targetPath = trim($_POST['path'] ?? $_FILES['file']['name'], '/');
    if ($targetPath === '') $targetPath = $_FILES['file']['name'];

    $out = safe_path($dest, $targetPath);
    if (!$out) json_out(['error' => 'Invalid path'], 400);

    $outDir = dirname($out);
    if (!is_dir($outDir)) mkdir($outDir, 0755, true);

    move_uploaded_file($_FILES['file']['tmp_name'], $out);
    json_out(['ok' => true, 'path' => $targetPath, 'size' => filesize($out)]);
}

// Delete a single file from a site (path passed in JSON body).
function api_delete_site_file(string $id): void {
    $site = get_site($id);
    if (!$site) json_out(['error' => 'Not found'], 404);

    $body     = json_decode(file_get_contents('php://input'), true) ?? [];
    $filePath = trim($body['path'] ?? '', '/');
    if ($filePath === '') json_out(['error' => 'No path specified'], 400);

    $dest = SITES_DIR . '/' . $id;
    $out  = safe_path($dest, $filePath);
    if (!$out) json_out(['error' => 'Invalid path'], 400);

    $real = realpath($out);
    if (!$real || !file_exists($real)) json_out(['error' => 'File not found'], 404);

    unlink($real);

    // Clean up empty parent directories (but never the site root itself)
    $realBase = realpath($dest);
    $parent   = dirname($real);
    while ($parent !== $realBase && is_dir($parent) && count(scandir($parent)) === 2) {
        rmdir($parent);
        $parent = dirname($parent);
    }

    json_out(['ok' => true]);
}

// ─── HTML page renderers ──────────────────────────────────────────────────────

// Shared terminal-style header. Pass optional nav link HTML for the right side.
function render_header(string $navHtml = ''): void { ?>
  <div class="vignette"></div>
  <header class="site-header">
    <a href="/" style="text-decoration:none;" aria-label="basi.onl home">
      <div class="title">B A S I . O N L <span class="blink-cursor"></span></div>
      <div class="subtitle">BASIC // ONLINE</div>
    </a>
    <?php if ($navHtml): ?>
      <nav class="header-nav"><?= $navHtml ?></nav>
    <?php endif; ?>
  </header>
<?php }

function render_upload_page(): void { ?>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>basi.onl — upload</title>
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <?php render_header('<a href="/admin" class="admin-link">admin</a>'); ?>

  <main>
    <div class="upload-card" id="dropzone">
      <div class="upload-icon" id="dropIcon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
      </div>
      <h1 class="upload-title">Drop a folder or ZIP</h1>
      <p class="upload-sub">Drag your project folder or a ZIP file here to host it instantly.</p>
      <div class="upload-buttons">
        <label class="btn btn-secondary">
          <input type="file" id="zipInput" accept=".zip" hidden>
          Choose ZIP
        </label>
        <label class="btn btn-secondary">
          <input type="file" id="folderInput" webkitdirectory mozdirectory multiple hidden>
          Choose folder
        </label>
      </div>
      <p class="upload-note">Serves at <span class="mono">basi.onl/<em>xxxxx</em></span> — no expiry</p>
    </div>

    <div class="status-card" id="statusCard" hidden>
      <div id="progressWrap">
        <div class="spinner"></div>
        <p id="progressLabel">Uploading…</p>
      </div>
      <div id="resultWrap" hidden>
        <div class="result-icon">✓</div>
        <p class="result-label">Live at</p>
        <a id="resultUrl" href="#" target="_blank" class="result-url"></a>
        <button class="btn btn-primary" id="copyBtn">Copy URL</button>
        <button class="btn btn-ghost" id="uploadAnother">Upload another</button>
      </div>
    </div>
  </main>

  <script>
  const dropzone      = document.getElementById('dropzone');
  const statusCard    = document.getElementById('statusCard');
  const progressWrap  = document.getElementById('progressWrap');
  const resultWrap    = document.getElementById('resultWrap');
  const progressLabel = document.getElementById('progressLabel');
  const resultUrl     = document.getElementById('resultUrl');
  const copyBtn       = document.getElementById('copyBtn');
  const uploadAnother = document.getElementById('uploadAnother');

  // ── Drag & drop ────────────────────────────────────────────────────────────
  let dragging = 0;
  document.addEventListener('dragover', e => e.preventDefault());
  document.addEventListener('dragenter', () => { dragging++; dropzone.classList.add('dragging'); });
  document.addEventListener('dragleave', () => { if (--dragging <= 0) { dragging = 0; dropzone.classList.remove('dragging'); } });
  document.addEventListener('drop', e => {
    e.preventDefault();
    dragging = 0;
    dropzone.classList.remove('dragging');
    handleDrop(e.dataTransfer);
  });

  // ── File inputs ────────────────────────────────────────────────────────────
  document.getElementById('zipInput').addEventListener('change', e => {
    if (e.target.files[0]) uploadZip(e.target.files[0]);
  });
  document.getElementById('folderInput').addEventListener('change', e => {
    if (e.target.files.length) uploadDirectoryFiles(e.target.files);
  });

  // ── Drop handler ───────────────────────────────────────────────────────────
  async function handleDrop(dt) {
    const items = [...(dt.items || [])];

    // Check for a ZIP file first
    const zipItem = items.find(item =>
      item.kind === 'file' && (
        item.type === 'application/zip' ||
        item.type === 'application/x-zip-compressed' ||
        (item.getAsFile && item.getAsFile()?.name?.endsWith('.zip'))
      )
    );
    if (zipItem) { const f = zipItem.getAsFile(); if (f) return uploadZip(f); }

    // Otherwise read as a directory tree
    const entryItems = items.filter(i => i.kind === 'file' && i.webkitGetAsEntry);
    if (!entryItems.length) return showError('Nothing readable was dropped.');

    showProgress('Reading directory…');
    const allFiles = [];

    async function readEntry(entry, base) {
      if (entry.isFile) {
        return new Promise(resolve => entry.file(f => { allFiles.push({ file: f, path: base + entry.name }); resolve(); }));
      }
      if (entry.isDirectory) {
        const reader = entry.createReader();
        return new Promise(resolve => {
          const readBatch = () => reader.readEntries(async entries => {
            if (!entries.length) return resolve();
            await Promise.all(entries.map(e => readEntry(e, base + entry.name + '/')));
            readBatch();
          });
          readBatch();
        });
      }
    }

    await Promise.all(entryItems.map(i => readEntry(i.webkitGetAsEntry(), '')));
    if (!allFiles.length) return showError('No files found in the dropped folder.');
    uploadDirectoryEntries(allFiles);
  }

  // ── Upload helpers ─────────────────────────────────────────────────────────
  function uploadZip(file) {
    showProgress('Uploading ZIP…');
    const fd = new FormData();
    fd.append('zip', file);
    fd.append('name', file.name.replace(/\.zip$/i, ''));
    doUpload(fd);
  }

  function uploadDirectoryFiles(fileList) {
    showProgress(`Uploading ${fileList.length} files…`);
    const fd = new FormData();
    for (const f of fileList) {
      // Use files[] so PHP receives them as an array
      fd.append('files[]', f, f.name);
      fd.append('paths[]', f.webkitRelativePath || f.name);
    }
    doUpload(fd);
  }

  function uploadDirectoryEntries(entries) {
    showProgress(`Uploading ${entries.length} files…`);
    const fd = new FormData();
    for (const { file, path } of entries) {
      fd.append('files[]', file, file.name);
      fd.append('paths[]', path);
    }
    doUpload(fd);
  }

  async function doUpload(formData) {
    try {
      const res  = await fetch('/upload', { method: 'POST', body: formData });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'Upload failed');
      showResult(data.url);
    } catch (err) {
      showError(err.message);
    }
  }

  // ── UI states ──────────────────────────────────────────────────────────────
  function showProgress(msg) {
    dropzone.hidden     = true;
    statusCard.hidden   = false;
    progressWrap.hidden = false;
    resultWrap.hidden   = true;
    progressLabel.textContent = msg;
  }

  function showResult(urlPath) {
    progressWrap.hidden = true;
    resultWrap.hidden   = false;
    const full = window.location.origin + urlPath;
    resultUrl.href = resultUrl.textContent = full;
    resultUrl.textContent = full.replace(/^https?:\/\//, '');
  }

  function showError(msg) {
    progressWrap.hidden = true;
    resultWrap.hidden   = false;
    resultWrap.innerHTML = `
      <div class="result-icon error-icon">✕</div>
      <p class="result-label" style="color:#ff6b6b">${msg}</p>
      <button class="btn btn-ghost" onclick="reset()">Try again</button>`;
  }

  function reset() {
    dropzone.hidden   = false;
    statusCard.hidden = true;
    document.getElementById('zipInput').value    = '';
    document.getElementById('folderInput').value = '';
  }

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(resultUrl.href).then(() => {
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = 'Copy URL'; }, 2000);
    });
  });
  uploadAnother.addEventListener('click', reset);
  </script>
</body>
</html>
<?php }

// ─────────────────────────────────────────────────────────────────────────────

function render_login_page(bool $error = false): void { ?>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>W.O.P.R. Terminal Access</title>
<link href="https://fonts.googleapis.com/css2?family=VT323&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --amber: #FF6600;
    --amber-dim: #7a3000;
    --amber-glow: rgba(255,102,0,0.4);
    --green: #00FF41;
    --green-dim: #004d14;
    --red: #FF2200;
    --yellow: #FFD700;
    --bg: #080808;
    --panel: #111111;
    --border: #333;
    --metal: #1a1a1a;
  }

  body {
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Share Tech Mono', monospace;
    overflow: hidden;
    position: relative;
  }

  /* CRT Scanlines */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.15) 2px,
      rgba(0,0,0,0.15) 4px
    );
    pointer-events: none;
    z-index: 1000;
  }

  /* CRT Vignette */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 60%, rgba(0,0,0,0.85) 100%);
    pointer-events: none;
    z-index: 999;
  }

  /* Ambient background glow */
  .bg-glow {
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(255,102,0,0.04) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* ===== MAIN PANEL ===== */
  .wopr-panel {
    position: relative;
    width: min(820px, 96vw);
    background: var(--panel);
    border: 3px solid #2a2a2a;
    border-top: 3px solid #3a3a3a;
    border-left: 3px solid #3a3a3a;
    box-shadow:
      0 0 0 1px #000,
      0 0 40px rgba(255,102,0,0.15),
      inset 0 0 30px rgba(0,0,0,0.8),
      inset 0 1px 0 rgba(255,255,255,0.05);
    border-radius: 6px;
    padding: 20px;
    z-index: 10;
  }

  /* Corner brackets */
  .wopr-panel::before, .wopr-panel::after {
    content: '';
    position: absolute;
    width: 20px; height: 20px;
    border-color: var(--amber);
    border-style: solid;
  }
  .wopr-panel::before {
    top: 8px; left: 8px;
    border-width: 2px 0 0 2px;
  }
  .wopr-panel::after {
    bottom: 8px; right: 8px;
    border-width: 0 2px 2px 0;
  }

  /* Extra corner brackets via child elements */
  .corner-tr, .corner-bl {
    position: absolute;
    width: 20px; height: 20px;
    border-color: var(--amber);
    border-style: solid;
  }
  .corner-tr { top: 8px; right: 8px; border-width: 2px 2px 0 0; }
  .corner-bl { bottom: 8px; left: 8px; border-width: 0 0 2px 2px; }

  /* ===== HEADER ===== */
  .wopr-header {
    text-align: center;
    margin-bottom: 16px;
    position: relative;
  }
  .wopr-title {
    font-family: 'VT323', monospace;
    font-size: clamp(18px, 3vw, 28px);
    color: var(--amber);
    letter-spacing: 6px;
    text-shadow: 0 0 10px var(--amber), 0 0 20px var(--amber-glow);
    text-transform: uppercase;
  }
  .wopr-subtitle {
    font-size: 10px;
    color: #555;
    letter-spacing: 3px;
    margin-top: 4px;
  }

  /* Status dots in header */
  .status-row {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 8px;
  }
  .status-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--amber-dim);
  }
  .status-dot.active { background: var(--amber); box-shadow: 0 0 6px var(--amber); }
  .status-dot.green-dot { background: var(--green); box-shadow: 0 0 6px var(--green); }
  .status-dot.red-dot { background: var(--red); box-shadow: 0 0 6px var(--red); }

  /* ===== MAIN BODY ROW: ear | center | ear ===== */
  .wopr-body {
    display: flex;
    gap: 12px;
    align-items: stretch;
  }

  /* ===== EARS ===== */
  .ear {
    display: flex;
    flex-direction: column;
    gap: 5px;
    justify-content: center;
    padding: 8px 6px;
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 4px;
    min-width: 28px;
  }
  .ear-led {
    width: 14px; height: 14px;
    border-radius: 2px;
    background: var(--amber-dim);
    border: 1px solid #1a1a1a;
    transition: background 0.1s, box-shadow 0.1s;
  }
  .ear-led.lit-amber { background: var(--amber); box-shadow: 0 0 6px var(--amber); }
  .ear-led.lit-green { background: var(--green); box-shadow: 0 0 6px var(--green); }
  .ear-led.lit-red   { background: var(--red);   box-shadow: 0 0 6px var(--red); }

  /* ===== CENTER COLUMN ===== */
  .wopr-center {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ===== EYES ROW ===== */
  .eyes-row {
    display: flex;
    gap: 12px;
    justify-content: space-between;
    align-items: flex-start;
  }

  .eye-panel {
    flex: 1;
    background: #0a0a0a;
    border: 1px solid #222;
    border-radius: 4px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .eye-label {
    font-size: 8px;
    color: #444;
    letter-spacing: 2px;
    text-align: center;
    margin-bottom: 4px;
  }
  .eye-grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 2px;
  }
  .eye-dot {
    aspect-ratio: 1;
    border-radius: 50%;
    background: #1a1a1a;
    border: 1px solid #111;
    transition: background 0.08s, box-shadow 0.08s;
  }
  .eye-dot.lit {
    background: var(--amber);
    box-shadow: 0 0 4px var(--amber), 0 0 8px var(--amber-glow);
  }
  .eye-dot.lit-dim {
    background: var(--amber-dim);
    box-shadow: none;
  }
  .eye-dot.lit-red {
    background: var(--red);
    box-shadow: 0 0 4px var(--red);
  }
  .eye-dot.lit-green {
    background: var(--green);
    box-shadow: 0 0 4px var(--green);
  }

  /* Eye label between eyes */
  .eye-center-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 80px;
    gap: 6px;
  }
  .system-label {
    font-family: 'VT323', monospace;
    font-size: 13px;
    color: var(--amber);
    letter-spacing: 2px;
    text-shadow: 0 0 6px var(--amber-glow);
    text-align: center;
  }
  .blink-cursor {
    display: inline-block;
    width: 8px; height: 14px;
    background: var(--amber);
    animation: blink 1s step-end infinite;
    box-shadow: 0 0 6px var(--amber);
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  /* ===== LOGIN FORM ===== */
  .login-section {
    background: #0a0a0a;
    border: 1px solid #222;
    border-radius: 4px;
    padding: 20px;
    position: relative;
  }
  .login-section::before {
    content: '[ SECURE TERMINAL ]';
    position: absolute;
    top: -8px; left: 50%;
    transform: translateX(-50%);
    background: #0a0a0a;
    color: #444;
    font-size: 9px;
    letter-spacing: 3px;
    padding: 0 8px;
  }

  .form-group {
    margin-bottom: 14px;
  }
  .form-label {
    display: block;
    font-size: 10px;
    color: #666;
    letter-spacing: 3px;
    margin-bottom: 6px;
    text-transform: uppercase;
  }
  .form-input {
    width: 100%;
    background: #050505;
    border: 1px solid #333;
    border-bottom: 1px solid var(--amber-dim);
    color: var(--amber);
    font-family: 'Share Tech Mono', monospace;
    font-size: 14px;
    padding: 10px 12px;
    outline: none;
    letter-spacing: 2px;
    transition: border-color 0.2s, box-shadow 0.2s;
    caret-color: var(--amber);
  }
  .form-input::placeholder {
    color: #2a2a2a;
    font-size: 11px;
    letter-spacing: 1px;
  }
  .form-input:focus {
    border-color: var(--amber);
    box-shadow: 0 0 0 1px var(--amber-dim), 0 0 12px var(--amber-glow);
  }

  .form-error {
    font-size: 10px;
    color: var(--red);
    letter-spacing: 2px;
    margin-bottom: 12px;
    text-shadow: 0 0 6px rgba(255,34,0,0.5);
  }

  .submit-btn {
    width: 100%;
    background: transparent;
    border: 1px solid var(--amber);
    color: var(--amber);
    font-family: 'VT323', monospace;
    font-size: 20px;
    letter-spacing: 4px;
    padding: 12px;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
    margin-top: 6px;
  }
  .submit-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--amber);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .submit-btn:hover {
    box-shadow: 0 0 20px var(--amber-glow), inset 0 0 20px rgba(255,102,0,0.1);
    text-shadow: 0 0 10px var(--amber);
  }
  .submit-btn:hover::before { opacity: 0.05; }
  .submit-btn:active { transform: scale(0.99); }

  .btn-text { position: relative; z-index: 1; }

  /* Pulse animation on button */
  @keyframes btnPulse {
    0%,100% { box-shadow: 0 0 8px var(--amber-glow); }
    50% { box-shadow: 0 0 20px var(--amber-glow), 0 0 40px rgba(255,102,0,0.2); }
  }
  .submit-btn { animation: btnPulse 3s ease-in-out infinite; }

  /* ===== VU METER / MOUTH ===== */
  .vu-meter {
    background: #0a0a0a;
    border: 1px solid #222;
    border-radius: 4px;
    padding: 10px 8px;
    position: relative;
  }
  .vu-label {
    font-size: 8px;
    color: #333;
    letter-spacing: 3px;
    text-align: center;
    margin-bottom: 6px;
  }
  .vu-rows {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .vu-row {
    display: flex;
    gap: 2px;
    justify-content: center;
  }
  .vu-seg {
    flex: 1;
    height: 8px;
    border-radius: 1px;
    background: #111;
    border: 1px solid #0a0a0a;
    transition: background 0.05s, box-shadow 0.05s;
    max-width: 18px;
  }
  .vu-seg.lit-g { background: var(--green); box-shadow: 0 0 4px var(--green); }
  .vu-seg.lit-y { background: var(--yellow); box-shadow: 0 0 4px var(--yellow); }
  .vu-seg.lit-r { background: var(--red); box-shadow: 0 0 4px var(--red); }

  /* ===== STATUS BAR ===== */
  .status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px solid #1a1a1a;
  }
  .status-text {
    font-size: 9px;
    color: #444;
    letter-spacing: 2px;
  }
  .status-text.active-status {
    color: var(--green);
    text-shadow: 0 0 6px var(--green);
    animation: textFlicker 4s infinite;
  }
  @keyframes textFlicker {
    0%,95%,100%{opacity:1} 96%{opacity:0.4} 97%{opacity:1} 98%{opacity:0.6}
  }

  /* ===== STATE CLASSES ===== */
  .wopr-panel.state-error .eye-dot.lit { background: var(--red); box-shadow: 0 0 4px var(--red); }
  .wopr-panel.state-error .form-input { border-color: var(--red); box-shadow: 0 0 12px rgba(255,34,0,0.3); }
  .wopr-panel.state-success .eye-dot.lit { background: var(--green); box-shadow: 0 0 4px var(--green); }

  @keyframes shake {
    0%,100%{transform:translateX(0)}
    20%{transform:translateX(-8px)}
    40%{transform:translateX(8px)}
    60%{transform:translateX(-5px)}
    80%{transform:translateX(5px)}
  }
  .shake { animation: shake 0.5s ease-in-out; }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 500px) {
    .ear { min-width: 18px; }
    .ear-led { width: 10px; height: 10px; }
    .eye-grid { grid-template-columns: repeat(7, 1fr); }
  }
</style>
</head>
<body>
